{
  "name": "hr-service-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:otel": "node --import ./dist/instrumentation.js dist/server.js",
    "dev:otel": "tsx --import ./instrumentation.ts src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:pull": "drizzle-kit pull",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests/integration",
    "pull:seed": "tsx scripts/seed.ts",
    "codegen": "graphql-codegen --config codegen.server.ts",
    "start:outbox": "node dist/workers/outbox-publisher.worker.js",
    "dev:outbox": "tsx watch src/worker.ts",
    "proto:generate": "node scripts/generate-proto.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/otel": "^0.20.1",
    "@graphql-tools/merge": "^9.2.4",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@grpc/reflection": "^1.0.4",
    "@internal/outbox-publisher": "github:kangdiancp/outbox-publisher#v0.1.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/instrumentation-pino": "^0.67.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sinclair/typebox": "^0.34.52",
    "dataloader": "^2.2.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-typebox": "^0.3.3",
    "fastify": "^5.12.0",
    "graphql": "^16.14.2",
    "mercurius": "^16.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@faker-js/faker": "^10.6.0",
    "@fastify/type-provider-json-schema-to-ts": "^5.0.0",
    "@graphql-codegen/cli": "^7.4.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@types/google-protobuf": "^3.15.12",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "grpc-tools": "^1.13.1",
    "json-schema-to-ts": "^3.1.1",
    "ts-proto": "^2.12.4",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
