@startuml
autonumber
skinparam BoxPadding 10
skinparam ParticipantPadding 10

actor "Producer / Kasir" as Producer
participant "Producer Engine\n(producer_3.ts)" as ProducerEngine
participant "Repo / DB Module\n(repo.ts & db.ts)" as Repo
database "PostgreSQL\n(resto_db)" as Postgres
participant "Outbox Relay\n(outbox.ts)" as Relay
database "Redis\n(BullMQ Engine)" as Redis
participant "Worker\n(worker_3.ts)" as Worker
participant "Status Dashboard\n(status_2.ts)" as StatusApp

== Fase 1: Producer Menyimpan Pesanan ke Postgres (Outbox Pattern) ==

Producer -> ProducerEngine: kirimPesanan(PesananInput)
activate ProducerEngine

ProducerEngine -> Repo: simpanPesanan(PesananInput)
activate Repo

Repo -> Postgres: BEGIN TRANSACTION
activate Postgres

Repo -> Postgres: INSERT INTO resto.orders ... ON CONFLICT DO NOTHING
note right: Idempotent Check:\nJika order_id sudah ada, kembalikan dibuat=false

alt Order Baru
    loop Untuk Setiap Menu dalam Pesanan
        Repo -> Postgres: INSERT INTO resto.order_items (status = 'PENDING')
        note right: Item tersimpan dengan status PENDING.\nPesanan aman meskipun Redis mati.
    end
    Repo -> Postgres: COMMIT TRANSACTION
    Postgres --> Repo: Pesanan & Item ID Berhasil Disimpan
else Order Duplikat
    Repo -> Postgres: ROLLBACK / CANCEL
    Postgres --> Repo: dibuat = false
end

deactivate Postgres
Repo --> ProducerEngine: { dibuat, itemIds }
deactivate Repo


== Fase 2: Outbox Relay (Memindahkan PENDING ke BullMQ) ==

alt Dipanggil Langsung dari Producer atau Loop Scheduler (startRelayLoop)
    ProducerEngine -> Relay: relayOnce()
    activate Relay
    
    Relay -> Postgres: BEGIN TRANSACTION
    activate Postgres
    Relay -> Postgres: SELECT ... FROM resto.order_items WHERE status = 'PENDING' FOR UPDATE SKIP LOCKED
    note right: Kunci baris agar aman dari eksekusi paralel

    loop Untuk Setiap Item PENDING
        Relay -> Redis: queue.add("masak", { itemId }, { jobId: "item-<id>", priority, delay })
        activate Redis
        Redis -> Redis: HSET job & ZADD (prioritized / delayed)
        Redis --> Relay: Job Terdaftar
        deactivate Redis
    end

    Relay -> Postgres: UPDATE resto.order_items SET status = 'QUEUED' WHERE item_id IN (...)
    Relay -> Postgres: COMMIT TRANSACTION
    deactivate Postgres

    Relay --> ProducerEngine: Item Diantrekan
    deactivate Relay
end

ProducerEngine --> Producer: Selesai
deactivate ProducerEngine


== Fase 3: Worker Mengambil & Memproses Item ==

Worker -> Redis: buatWorker(WorkerCode) -> Ambil Job
activate Worker
activate Redis

Redis -> Redis: ZPOPMIN / RPOPLPUSH (Ambil Job Berdasarkan Priority)
Redis --> Worker: ItemJob { itemId }
deactivate Redis

Worker -> Repo: mulaiMasak(itemId, koki, percobaan)
activate Repo
Repo -> Postgres: UPDATE resto.order_items SET status = 'COOKING', attempts = N WHERE status IN ('PENDING', 'QUEUED', 'RETRYING', 'COOKING')
activate Postgres

alt Item Valid (Belum DONE / FAILED)
    Postgres --> Repo: Data Item & Order
    Repo -> Postgres: UPDATE resto.orders SET status = 'IN_PROGRESS'
    Repo --> Worker: ItemDimasak Payload
    
    Worker -> Worker: Memasak (Sleep & updateProgress 25% - 100%)

    alt Sukses Memasak
        Worker -> Repo: tandaiSelesai(itemId)
        Repo -> Postgres: UPDATE resto.order_items SET status = 'DONE'
        Repo -> Postgres: hitungStatusOrder() (Update order ke READY jika semua item DONE)
        Worker -> Redis: Event "completed"

    else Gagal Memasak (Simulasi / Error)
        Worker -> Repo: catatGagal(itemId, pesan, permanen, percobaan)
        Repo -> Postgres: UPDATE resto.order_items SET status = (permanen ? 'FAILED' : 'RETRYING')
        Repo -> Postgres: hitungStatusOrder()
        Worker -> Redis: Event "failed"
    end

else Item Sudah DONE/FAILED atau Duplikat
    Postgres --> Repo: null (0 rows updated)
    Repo --> Worker: null
    Worker -> Worker: Lewati Pemrosesan (Idempotent Guard)
end

deactivate Postgres
deactivate Repo
deactivate Worker


== Fase 4: Pemantauan Dua Sudut Pandang (status_2.ts) ==

StatusApp -> Postgres: hitungItemPerStatus(), pesananTerbaru(), itemGagal()
activate StatusApp
activate Postgres
Postgres --> StatusApp: Data Bisnis & Item Status dari DB
deactivate Postgres

StatusApp -> Redis: queue.getJobCounts()
activate Redis
Redis --> StatusApp: Data Job State dari Redis
deactivate Redis

StatusApp -> StatusApp: Tampilkan Konsistensi Data (Postgres vs Redis)
deactivate StatusApp


== Fase 5: Graceful Shutdown ==

[o-> Worker: Sinyal SIGINT / SIGTERM (Ctrl+C)
Worker -> Relay: hentikanRelay()
Worker -> Redis: worker.close()
Worker -> Postgres: pool.end()
Worker --> Worker: Selesai Secara Bersih (Graceful Exit)

@enduml