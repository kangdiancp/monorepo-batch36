PORT=3001
NODE_ENV=production

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hr_db_batch35
DB_USER=postgres
DB_PASSWORD=admin
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE=10000

# JWT

JWT_ACCESS_SECRET="super-secret-access-token-key-indonesia-colocation-2026-xyz"
JWT_REFRESH_SECRET="super-highly-secure-refresh-token-key-hino-project-987-abc"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email
MAIL_PASSWORD=your_app_password (not email password )
MAIL_FROM=your_email


# ── Storage driver ──────────────────────────────────────
# Pilih: 'local' atau 'cloudinary', 'awss3'
STORAGE_DRIVER=local

# Konfigurasi Cloudinary (jika pake STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=user_documents

# Upload limits
MAX_FILE_SIZE_MB=10

# Swagger
SWAGGER_ENABLED=true

# Konfigurasi Server Express (Opsional)
PORT=3000

# Konfigurasi local storage
LOCAL_UPLOAD_DIR=uploads
LOCAL_BASE_URL=http://localhost:3000

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
