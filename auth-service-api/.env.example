PORT=
NODE_ENV=

# PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_MAX=
DB_POOL_MIN=
DB_POOL_IDLE=

# JWT

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=
JWT_REFRESH_EXPIRES=

# Mail
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=


# ── Storage driver ──────────────────────────────────────
# Pilih: 'local' atau 'cloudinary', 'awss3'
STORAGE_DRIVER=

# Konfigurasi local storage
LOCAL_UPLOAD_DIR=
LOCAL_BASE_URL=

# Konfigurasi Cloudinary (jika pake STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=user_documents

# Upload limits
MAX_FILE_SIZE_MB=10

# Swagger
SWAGGER_ENABLED=true

# Konfigurasi Server Express (Opsional)
PORT=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
